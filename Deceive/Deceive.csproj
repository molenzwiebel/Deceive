<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <AssemblyVersion>1.18.0.0</AssemblyVersion>
    <ApplicationIcon>Resources\deceive.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Native AOT: produces a single self-contained executable. -->
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <!-- Small, mostly idle heap: background GC only adds a thread and memory overhead here. -->
    <ConcurrentGarbageCollection>false</ConcurrentGarbageCollection>
    <IsAotCompatible>true</IsAotCompatible>
    <!-- Native symbols can't be embedded in the exe; keep the .pdb in obj/ instead of the publish folder. -->
    <CopyOutputSymbolsToPublishDirectory>false</CopyOutputSymbolsToPublishDirectory>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="Resources\games\*.png" LogicalName="games.%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
